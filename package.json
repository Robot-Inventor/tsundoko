{
  "name": "tsundoko",
  "version": "0.0.0",
  "private": true,
  "description": "Lightweight, AI-first bookmarking app",
  "homepage": "https://github.com/Robot-Inventor/tsundoko#readme",
  "bugs": {
    "url": "https://github.com/Robot-Inventor/tsundoko/issues"
  },
  "license": "MIT",
  "author": "Robot-Inventor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robot-Inventor/tsundoko.git"
  },
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "knip && tsrs && oxlint src",
    "dev": "bun run --parallel dev:ui dev:server",
    "dev:ui": "vite",
    "dev:server": "bun --watch src/server.ts",
    "build": "vite build",
    "start": "bun src/server.ts",
    "ci:version": "changeset version",
    "ci:publish": "changeset publish"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/bun": "^1.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "hono": "^4.13.19",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@robot-inventor/oxlint-config": "^2.2.0",
    "@robot-inventor/tsconfig-base": "^7.2.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "knip": "^6.47.0",
    "oxc-transform-react": "^0.156.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tailwindcss": "^4.3.5",
    "tsrs": "^7.1.0-beta.tsrs3",
    "vite": "^8.3.8"
  }
}
