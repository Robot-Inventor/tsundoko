{
  "name": "tsundoko",
  "version": "0.0.0",
  "private": true,
  "description": "Lightweight, AI-first bookmarking app",
  "homepage": "https://github.com/Robot-Inventor/tsundoko#readme",
  "bugs": {
    "url": "https://github.com/Robot-Inventor/tsundoko/issues"
  },
  "license": "MIT",
  "author": "Robot-Inventor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robot-Inventor/tsundoko.git"
  },
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "knip && tsrs && oxlint src",
    "dev": "bun run --parallel dev:ui dev:server",
    "dev:ui": "vite",
    "dev:server": "bun --watch src/server.ts",
    "build": "vite build",
    "start": "bun src/server.ts",
    "test": "vitest run",
    "ci:version": "changeset version",
    "ci:publish": "changeset publish",
    "migrate:create": "drizzle-kit generate",
    "migrate:apply": "drizzle-kit migrate",
    "embeddings:backfill": "bun src/db/backfillEmbeddings.ts"
  },
  "dependencies": {
    "@arkenv/core": "^1.0.0-rc.4",
    "@base-ui/react": "^1.9.0",
    "@better-auth/core": "^1.7.27",
    "@better-auth/passkey": "^1.7.27",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/bun": "^1.0.1",
    "@mozilla/readability": "^0.6.0",
    "@tanstack/react-router": "^1.170.46",
    "@xeet/core": "^0.1.2",
    "arktype": "^2.2.10",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "encoding-sniffer": "^1.0.2",
    "hono": "^4.13.20",
    "linkedom": "^0.18.15",
    "lucide-react": "^1.78.0",
    "open-graph-scraper": "^6.13.0",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-stringify": "^11.0.0",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@robot-inventor/oxlint-config": "^2.2.0",
    "@robot-inventor/tsconfig-base": "^7.2.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testcontainers/postgresql": "^12.2.2",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "knip": "^6.47.0",
    "oxc-transform-react": "^0.158.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tailwindcss": "^4.3.5",
    "tsrs": "^7.1.0-beta.tsrs4",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "bun": "1.4.5",
    "node": "26.13.1"
  }
}
